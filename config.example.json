    "tasks_data_source": "<Tasks database data source id, optional>",
    "opportunities_data_source": "<Opportunities data source id>",
    "companies_data_source": "<Companies data source id>",
    "meetings_data_source": "<Meeting Notes data source id>",
    "board_url": "https://<your-board>.vercel.app"
  }
}
